+#if TARGET_OS_IPHONE || defined(DM_TEST_GPUARCHIVER)
+static BOOL ga_is_directory(NSString *path) {
+    struct stat st;
+    return lstat(path.fileSystemRepresentation, &st) == 0 && S_ISDIR(st.st_mode);
+}
+static NSArray<NSString *> *ga_old_folders(NSString *documents) {
+    if (!documents.isAbsolutePath || ![documents.lastPathComponent isEqualToString:@"Documents"]) return @[];
+    // LiveContainer gives the guest its own Documents directory. Darwin's process cache path is not a reliable guest container locator.
+    NSString *container = documents.stringByDeletingLastPathComponent.stringByResolvingSymlinksInPath;
+    NSString *cache = [container stringByAppendingPathComponent:@"Library/Caches/com.apple.gpuarchiver"];
+    if (![cache isEqualToString:cache.stringByResolvingSymlinksInPath] || !ga_is_directory(cache)) return @[];
+    NSError *error = nil;
+    NSArray<NSString *> *names = [NSFileManager.defaultManager contentsOfDirectoryAtPath:cache error:&error];
+    if (!names) MLOG("gpuarchiver: cannot list the game cache: %s", error.localizedDescription.UTF8String ?: "unknown error");
+    NSMutableArray<NSString *> *folders = [NSMutableArray array];
+    for (NSString *name in names) {
+        if (![name hasPrefix:@"gpuarchiver-"]) continue;
+        NSString *path = [cache stringByAppendingPathComponent:name];
+        if (ga_is_directory(path)) [folders addObject:path];
+    }
+    return folders;
+}
+static NSUInteger ga_remove_folders(NSArray<NSString *> *folders) {
+    NSUInteger removed = 0;
+    for (NSString *path in folders) {
+        if (ga_is_directory(path) && [NSFileManager.defaultManager removeItemAtPath:path error:nil]) removed++;
+    }
+    return removed;
+}
