+#if TARGET_OS_IPHONE
+static BOOL ga_is_directory(NSString *path) {
+    struct stat st;
+    return lstat(path.fileSystemRepresentation, &st) == 0 && S_ISDIR(st.st_mode);
+}
+static int ga_check_cache_directory(NSString *path, BOOL optional) {
+    struct stat st;
+    if (lstat(path.fileSystemRepresentation, &st) == 0) {
+        if (S_ISDIR(st.st_mode)) return 0;
+        MLOG("gpuarchiver: skipped cleanup; %s is not a physical directory", path.fileSystemRepresentation);
+        return ENOTDIR;
+    }
+    int error = errno;
+    if (!optional || error != ENOENT) MLOG("gpuarchiver: cannot inspect %s: %s", path.fileSystemRepresentation, strerror(error));
+    return error;
+}
+static NSArray<NSString *> *ga_old_folders(NSString *documents, NSString *bundle) {
+    if (!documents.isAbsolutePath || ![documents.lastPathComponent isEqualToString:@"Documents"]) {
+        MLOG("gpuarchiver: skipped cleanup; invalid boot Documents path");
+        return nil;
+    }
+    // Use the container already selected at boot. Check each descendant without following symlinks or relying on path spelling.
+    NSString *cache = documents.stringByDeletingLastPathComponent;
+    for (NSString *part in @[@"Library", @"Caches"]) {
+        cache = [cache stringByAppendingPathComponent:part];
+        if (ga_check_cache_directory(cache, NO)) return nil;
+    }
+    // LiveContainer's Metal cache is scoped to the guest bundle ID. A normal install can use the unscoped path.
+    if (!bundle.length || [bundle isEqualToString:@"."] || [bundle isEqualToString:@".."] ||
+        [bundle rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"].invertedSet].location != NSNotFound) {
+        MLOG("gpuarchiver: skipped cleanup; invalid app bundle identifier");
+        return nil;
+    }
+    NSString *scoped = [cache stringByAppendingPathComponent:bundle];
+    int status = ga_check_cache_directory(scoped, YES);
+    if (!status) {
+        scoped = [scoped stringByAppendingPathComponent:@"com.apple.gpuarchiver"];
+        status = ga_check_cache_directory(scoped, YES);
+    }
+    if (!status) cache = scoped;
+    else if (status == ENOENT) {
+        cache = [cache stringByAppendingPathComponent:@"com.apple.gpuarchiver"];
+        if (ga_check_cache_directory(cache, NO)) return nil;
+    } else return nil;
+    NSError *error = nil;
+    NSArray<NSString *> *names = [NSFileManager.defaultManager contentsOfDirectoryAtPath:cache error:&error];
+    if (!names) {
+        MLOG("gpuarchiver: cannot list the game cache: %s", error.localizedDescription.UTF8String ?: "unknown error");
+        return nil;
+    }
+    NSMutableArray<NSString *> *folders = [NSMutableArray array];
+    for (NSString *name in names) {
+        if (![name hasPrefix:@"gpuarchiver-"]) continue;
+        NSString *path = [cache stringByAppendingPathComponent:name];
+        if (ga_is_directory(path)) [folders addObject:path];
+    }
+    MLOG("gpuarchiver: found %lu old work directories among %lu entries in %s", (unsigned long)folders.count, (unsigned long)names.count, cache.fileSystemRepresentation);
+    return folders;
+}
+static NSUInteger ga_remove_folders(NSArray<NSString *> *folders) {
+    NSUInteger removed = 0;
+    BOOL loggedFailure = NO;
+    for (NSString *path in folders) {
+        if (!ga_is_directory(path)) continue;
+        NSError *error = nil;
+        if ([NSFileManager.defaultManager removeItemAtPath:path error:&error]) removed++;
+        else if (!loggedFailure) {
+            loggedFailure = YES;
+            MLOG("gpuarchiver: could not remove %s: %s", path.lastPathComponent.UTF8String, error.localizedDescription.UTF8String ?: "unknown error");
+        }
+    }
+    return removed;
+}
+#if TARGET_OS_IPHONE
+void dm_ios_gpuarchiver_cleanup(NSString *documents) {
+    NSArray<NSString *> *old = ga_old_folders(documents, NSBundle.mainBundle.bundleIdentifier);
+    if (old.count) dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        NSUInteger removed = ga_remove_folders(old);
+        MLOG("gpuarchiver: removed %lu of %lu old Metal work directories from the game cache", (unsigned long)removed, (unsigned long)old.count);
+    });
+}
