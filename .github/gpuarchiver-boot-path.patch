+static BOOL ga_is_directory(NSString *path) {
+    struct stat st;
+    return lstat(path.fileSystemRepresentation, &st) == 0 && S_ISDIR(st.st_mode);
+}
+static NSArray<NSString *> *ga_old_folders(NSString *documents) {
+    if (!documents.isAbsolutePath || ![documents.lastPathComponent isEqualToString:@"Documents"]) {
+        MLOG("gpuarchiver: skipped cleanup; invalid boot Documents path");
+        return nil;
+    }
+    // Use the container already selected at boot. Check each descendant without following symlinks or relying on path spelling.
+    NSString *cache = documents.stringByDeletingLastPathComponent;
+    for (NSString *part in @[@"Library", @"Caches", @"com.apple.gpuarchiver"]) {
+        cache = [cache stringByAppendingPathComponent:part];
+        struct stat st;
+        if (lstat(cache.fileSystemRepresentation, &st) != 0) {
+            int error = errno;
+            MLOG("gpuarchiver: cannot inspect %s: %s", cache.fileSystemRepresentation, strerror(error));
+            return nil;
+        }
+        if (!S_ISDIR(st.st_mode)) {
+            MLOG("gpuarchiver: skipped cleanup; %s is not a physical directory in the game container", part.UTF8String);
+            return nil;
+        }
+    }
+    NSError *error = nil;
+    NSArray<NSString *> *names = [NSFileManager.defaultManager contentsOfDirectoryAtPath:cache error:&error];
+    if (!names) {
+        MLOG("gpuarchiver: cannot list the game cache: %s", error.localizedDescription.UTF8String ?: "unknown error");
+        return nil;
+    }
+    NSMutableArray<NSString *> *folders = [NSMutableArray array];
+    for (NSString *name in names) {
+        if (![name hasPrefix:@"gpuarchiver-"]) continue;
+        NSString *path = [cache stringByAppendingPathComponent:name];
+        if (ga_is_directory(path)) [folders addObject:path];
+    }
+    MLOG("gpuarchiver: found %lu old work directories among %lu entries in %s", (unsigned long)folders.count, (unsigned long)names.count, cache.fileSystemRepresentation);
+    return folders;
+}
+static NSUInteger ga_remove_folders(NSArray<NSString *> *folders) {
+    NSUInteger removed = 0;
+    BOOL loggedFailure = NO;
+    for (NSString *path in folders) {
+        if (!ga_is_directory(path)) continue;
+        NSError *error = nil;
+        if ([NSFileManager.defaultManager removeItemAtPath:path error:&error]) removed++;
+        else if (!loggedFailure) {
+            loggedFailure = YES;
+            MLOG("gpuarchiver: could not remove %s: %s", path.lastPathComponent.UTF8String, error.localizedDescription.UTF8String ?: "unknown error");
+        }
+    }
+    return removed;
+}
