 }
+static void reclaim_old_compiler_folders(void) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSString *container = [@(archive_cache_root) stringByAppendingPathComponent:@"guest"];
+    NSString *docs = [container stringByAppendingPathComponent:@"Documents"];
+    NSString *cache = [container stringByAppendingPathComponent:@"Library/Caches/com.apple.gpuarchiver"];
+    NSString *old = [cache stringByAppendingPathComponent:@"gpuarchiver-old"];
+    NSString *live = [cache stringByAppendingPathComponent:@"gpuarchiver-live"];
+    NSString *link = [cache stringByAppendingPathComponent:@"gpuarchiver-link"];
+    NSString *other = [cache stringByAppendingPathComponent:@"other"];
+    NSString *archive = [docs stringByAppendingPathComponent:@"pso_archive"];
+    NSString *foreign = [@(archive_cache_root) stringByAppendingPathComponent:@"com.apple.gpuarchiver/gpuarchiver-foreign"];
+    for (NSString *path in @[old, other, archive, foreign])
+        if (![fm createDirectoryAtPath:path withIntermediateDirectories:YES attributes:nil error:nil]) abort();
+    if (![fm createSymbolicLinkAtPath:link withDestinationPath:foreign error:nil]) abort();
+    NSArray<NSString *> *snapshot = ga_old_folders(docs);
+    if (![fm createDirectoryAtPath:live withIntermediateDirectories:NO attributes:nil error:nil]) abort();
+    EXPECT("guest cache: only the old work directory is selected", 1, snapshot.count);
+    EXPECT("guest cache: old folder removed", 1, ga_remove_folders(snapshot));
+    EXPECT("guest cache: old folder gone", 0, [fm fileExistsAtPath:old]);
+    for (NSString *path in @[live, link, other, archive, foreign])
+        EXPECT(path.UTF8String, 1, [fm fileExistsAtPath:path]);
+    NSString *linkedGuest = [@(archive_cache_root) stringByAppendingPathComponent:@"linked-guest"];
+    NSString *linkedDocs = [linkedGuest stringByAppendingPathComponent:@"Documents"];
+    if (![fm createDirectoryAtPath:linkedDocs withIntermediateDirectories:YES attributes:nil error:nil] ||
+        ![fm createSymbolicLinkAtPath:[linkedGuest stringByAppendingPathComponent:@"Library"]
+                 withDestinationPath:[container stringByAppendingPathComponent:@"Library"] error:nil]) abort();
+    EXPECT("guest cache: symlinked Library is ignored", 0, ga_old_folders(linkedDocs).count);
+}
 int main(int argc, char **argv) { @autoreleasepool {
     if (!mkdtemp(archive_cache_root)) abort();
     atexit(archive_cache_cleanup);
     if (![NSFileManager.defaultManager createDirectoryAtPath:[@(archive_cache_root) stringByAppendingPathComponent:@"com.apple.gpuarchiver"]
                                withIntermediateDirectories:NO attributes:nil error:nil]) abort();
+    reclaim_old_compiler_folders();
     char dir[] = "/tmp/t_pso_archive.XXXXXX"; if (!mkdtemp(dir)) abort();
     setenv("DM_PSO_ARCHIVE", argc == 3 ? argv[2] : dir, 1);
