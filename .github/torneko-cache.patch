 // Cache storage (Tears of the Kingdom; its first list call opened fsp-srv and aborted in sm::Initialize): storage <index> is the host folder <temporary storage>_cache<index>,
 // created when it is created or mounted. The list reports none (a fresh console), so the game creates its storage at every boot; creating an existing one succeeds
 static const char *cache_dir(int index, char *b, size_t n) { char t[1024]; snprintf(b, n, "%s_cache%d", envdir("DM_TEMP", "run/platform/temp", t, sizeof t), index); return b; }
+// The SDK's query dereferences an am service that the host never creates.
+// Read the application's original control metadata, including a zero capacity.
+HLE_FORCE("_ZN2nn2fs18GetCacheStorageMaxEPiPl", "application cache capacity from control metadata", Result, h_fs_CacheMax, int *index, int64_t *size) {
+    const char *path = getenv("DM_CONTROL_NACP");
+    if (!index || !size || !path || !*path) return RES_FAIL;
+    FILE *file = fopen(path, "rb");
+    if (!file) return RES_FAIL;
+    uint8_t data[0x4000];
+    size_t got = fread(data, 1, sizeof data, file);
+    int extra = fgetc(file), failed = ferror(file);
+    fclose(file);
+    if (got != sizeof data || extra != EOF || failed) return RES_FAIL;
+    uint64_t maximum = 0;
+    for (int i = 7; i >= 0; i--) maximum = (maximum << 8) | data[0x3180 + i];
+    if (maximum > INT64_MAX) return RES_FAIL;
+    *index = data[0x3188] | (data[0x3189] << 8);
+    *size = (int64_t)maximum;
+    LOG("fs cache maximum: index %d, data and journal %lld bytes", *index, (long long)*size);
+    return RES_OK;
+}
